{
  "$schema": "https://schemas.hercules.app/iam/v1.json",
  "version": "v1",

  // App permissions. Declare concrete actions (no wildcards) as
  // app.<resourceType>:<action>, then attach them to roles below. Starts empty:
  // add a permission here, then list it in a role's "permissions".
  "permissions": {},

  // Resource types for the ReBAC graph. Nest a type under another with "parent";
  // a role granted on a parent applies to its descendants. Starts empty: add a
  // type when a feature needs per-resource access.
  "resourceTypes": {},

  // The four platform-seeded roles. Grant each role its permissions inline via
  // "permissions" (there is no separate rolePermissions map). "app_owner" is
  // app-scoped (app-wide authority, primary tenant only). "member" is the tenant
  // default conferred on new members.
  "roles": {
    "app_owner": { "name": "App Owner", "isAppScope": true, "permissions": [] },
    "owner": { "name": "Owner", "permissions": [] },
    "admin": { "name": "Admin", "permissions": [] },
    "member": { "name": "Member", "isDefault": true, "permissions": [] },
  },
}
